# ==== 1. BOT ====
# BotFather'dan olingan token
BOT_TOKEN=
# Direktor / HR Telegram ID lari (vergul bilan). Bazadagi role=admin ham admin hisoblanadi.
ADMIN_IDS=
# Ishchi guruh ID (ixtiyoriy — guruh ichida /guruh_ulash yozsangiz ham bo'ladi)
GROUP_CHAT_ID=

# ==== 2. BAZA (Supabase / PostgreSQL) ====
# Supabase → Project Settings → Database → Database password
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Ulanmasa: Connection string → Session pooler dagi host
SUPABASE_POOLER_HOST=
# Yoki to'liq satr (yozilsa yuqoridagilar e'tiborga olinmaydi)
DATABASE_URL=
# Postgres bo'lmasa — mahalliy SQLite fayl
DB_PATH=./data/bot.db

# ==== 3. ISH TARTIBI ====
COMPANY_NAME=BayLog Cargo
# Direktor ismi (xabarlarda; botda Panel → «🏷 Nomlar» dan ham o'zgaradi)
BOSS_NAME=Direktor
# 1 — bazadagi role=admin hodim (direktor) ham davomat/KPI ga kiradi. Standart: direktor hodim emas
BOSS_IS_STAFF=0
TIMEZONE=Asia/Tashkent
# Umumiy ish boshlanishi HH:mm (botda Panel → «🕘 Ish vaqti» dan o'zgaradi va ustun bo'ladi).
# Bo'sh bo'lsa eski WORK_START_HOUR olinadi (9 → 09:00)
WORK_START=
WORK_START_HOUR=9
WORK_END_HOUR=18
# Ish kunlari (cron ko'rinishida): 1-6 = dushanba–shanba, 1-5 = dushanba–juma
WORK_DAYS=1-6
# Ochiq missiya eslatmasi har necha soatda
REMINDER_INTERVAL_HOURS=2

# Kechikish: ish boshlanishidan necha daqiqa keyin "kech keldi" hisoblanadi
LATE_GRACE_MINUTES=10
# Kech kelgan hodimdan sabab so'ralsinmi
ASK_LATE_REASON=true
# «⏰ Kech qolaman» ish boshlanishidan shuncha daqiqa OLDIN aytilsa — kechikish hisoblanmaydi (0 — o'chiq)
LATE_NOTICE_MIN_BEFORE=60
# «Bajardim» isboti (rasm/video/audio/fayl) majburiymi. 0 — «⏭ Isbotsiz yuborish» tugmasi bor
PROOF_REQUIRED=0

# KPI: har bir qaytarilgan ish topshiriq foizidan necha % ayiradi (0 — jarima yo'q)
RETURN_PENALTY_PCT=5
# KPI summasi: score — bonus fondi × ball / 100 (standart); gate — shart bajarilsa TO'LIQ, aks holda 0
KPI_MODE=score
# gate rejimi shartlari: oyda ruxsat etilgan kechikish / sababsiz kelmaslik / muddatida bajarilmagan ish
KPI_MAX_LATE=0
KPI_MAX_ABSENT=0
KPI_MAX_MISSED_TASKS=0
KPI_EXCUSED_OK=true

# ==== 4. GURUH VA HISOBOTLAR ====
# Kun oxirida guruhga qisqa hisobot (KPI/pul chiqmaydi)
DAILY_GROUP_REPORT=true
# Real vaqtda guruhga e'lon: ishga keldi/ketdi, missiya bajarildi, kelmayman dedi
ANNOUNCE_DONE=true
# Kunlik hisobot: hodim «Ketdim» bosganda hisobot yo'q bo'lsa so'raladi, ish tugashidan oldin eslatma
DAILY_REPORT_REQUIRED=true
DAILY_REPORT_REMIND_MIN=30

# ==== 5. OFIS / TEXNIK ====
# Ofis geofence radiusi (metr) — ofis nuqtasi botda /ofis bilan belgilanadi (filiallar — Panel → «🏙 Filiallar»)
OFFICE_RADIUS_M=250
# 1 — aniqligi yo'q (xaritadan tanlangan bo'lishi mumkin) joylashuv rad etiladi
STRICT_GPS=0
# «Keldim» uchun video majburiymi (ofis hodimlari). Hudud agentlariga — kartochkada alohida
OFFICE_CHECKIN_VIDEO=false
# Hudud (agent) rejimi: uydan kamida shuncha metr uzoqda bo'lsa «Keldim» qabul qilinadi
FIELD_MIN_DISTANCE_M=1000
# Har oyning 1-kuni «yangi ish oyi» xabarini tasdiqlamaguncha «Keldim» yopiq bo'lsinmi
MONTH_START_REQUIRED=false
# SQLite zaxira nusxalari (faqat SQLite rejimida): nechta kun saqlansin
BACKUP_KEEP=14
# CRM uchun faqat o'qiladigan manzil: GET /crm/snapshot (x-crm-secret sarlavhasi). Bo'sh — o'chirilgan.
CRM_API_SECRET=
# HTTP porti: health-check + Web App + /crm/snapshot
PORT=8000

# ==== 6. WEB APP (Telegram Mini App) ====
# https://<domen>/app — yozilsa hodimlarda «📱 Ilova» tugmasi paydo bo'ladi. Bo'sh — o'chiq
WEBAPP_URL=
# Ilova kirish kaliti necha soniya amal qiladi
WEBAPP_AUTH_TTL=86400
